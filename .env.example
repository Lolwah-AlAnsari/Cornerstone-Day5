# Copy to .env.local for reference, and set these in Vercel:
#   Project Settings -> Environment Variables
#
# Both values are safe to expose in the browser. The publishable (anon) key is
# designed for client-side use; Row Level Security is what protects the data.
# Never put a service-role key here.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
